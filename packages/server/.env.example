# Environment for the OpenMediaVault self-hosted stack (docker-compose.omv.yml).
# Copy to `.env` (git-ignored) beside the compose file and fill in real values.

# Absolute path on the NAS array where the Postgres data volume lives.
# Find your array mount in OMV > Storage > File Systems, then point at an
# appdata subdirectory, e.g.:
POSTGRES_VOLUME=/srv/dev-disk-by-uuid-XXXXXXXX/appdata/familiar-cache/postgres

# Admin dashboard password, required for /admin login. Left empty here on
# purpose: an unset password makes /admin answer 503 rather than opening,
# so a copied-and-forgotten example cannot leave a working default in place.
#   CACHE_ADMIN_PASSWORD=$(python3 -c 'import secrets;print(secrets.token_urlsafe(24))')
CACHE_ADMIN_PASSWORD=

# Ingress is handled by Tailscale Funnel on the host (no token needed here):
#   tailscale funnel --bg --https=443 http://127.0.0.1:8000

# Optional: override the Postgres password (defaults to `cache`). The DB is not
# exposed to the host, so the default is acceptable. Setting it here is enough —
# CACHE_DATABASE_URL interpolates the same variable, so the two cannot drift.
# POSTGRES_PASSWORD=cache
