# `ADR-0003` point 7: TLS terminates in front of the application.
#
# **Writes are open.** They were refused here while `ADR-0004` point 7's delete
# path did not exist — "a public corpus needs takedown for legal requests and
# retraction for poisoned recordings" — and that route now does, admin-only, by
# fingerprint hash and by client identifier. The refusal was topological rather
# than an authentication scheme precisely so that removing it would be one block
# of this file and nothing else.
#
# What still bounds a write, none of which is a wall in front of contributing:
# a per-address rate limit, `ADR-0004` point 9's ceiling on corpus rows, and the
# fact that an unattributed submission can never be confirmed (point 3).

{
	email {$TLS_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The admin surface is not a public thing. It is password-protected in the
	# application, but a login form on a public host is a login form to guess at.
	handle /admin* {
		respond 404
	}

	handle {
		reverse_proxy api:8000
	}
}
