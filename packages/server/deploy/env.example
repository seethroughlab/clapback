# Copy to packages/server/.env on the instance. Never committed — see .gitignore.

# The domain this serves. Caddy needs it to obtain a certificate, so TLS does not
# come up until it is set and its A record points at this instance.
# `ADR-0001` deferred item 6 decides what this should be.
DOMAIN=corpus.example.org
TLS_EMAIL=you@example.org

# Postgres. There is no host port (`ADR-0005` point 12), so this password guards
# the container network rather than the internet — which is not a reason to make
# it guessable.
POSTGRES_PASSWORD=

# The admin dashboard. Caddy 404s /admin on the public host, so this is reachable
# only over the private network; it still needs to be strong.
CACHE_ADMIN_PASSWORD=

# `ADR-0004` point 9's ceiling on corpus rows: growth is a decision rather than a
# surprise. 500,000 is `ADR-0003` point 11's stated comfortable limit for a 2 GB
# instance — where the HNSW index is around 780 MB and still fits in page cache.
# Raise it deliberately, having thought about RAM.
CACHE_MAX_EMBEDDINGS=500000

# Nightly backup — `ADR-0003` point 6, which makes this part of shipping rather
# than a follow-up. The bucket is the one Familiar already backs up to.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=clapback/postgres
AWS_DEFAULT_REGION=us-east-1
