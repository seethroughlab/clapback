{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteDumpsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::clapback-backup/postgres/*"
    },
    {
      "Sid": "ListSoTheScriptCanVerifyItsOwnUpload",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::clapback-backup",
      "Condition": {"StringLike": {"s3:prefix": "postgres/*"}}
    }
  ]
}
